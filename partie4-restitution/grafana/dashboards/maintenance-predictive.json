    {
      "id": 10,
      "type": "table",
      "title": "Disques sains vs disques tombés en panne",
      "description": "Moyennes sur toutes les observations ; écart = en panne ÷ sains",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-maintenance"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-maintenance"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"smart_reference\" and r._field == \"valeur\")\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"attribut\"], columnKey: [\"groupe\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({r with ratio: if exists r.sain and exists r.panne and r.sain > 0.0 then r.panne / r.sain else 0.0}))\n  |> keep(columns: [\"attribut\", \"sain\", \"panne\", \"ratio\"])\n  |> sort(columns: [\"attribut\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "attribut": "Attribut SMART",
              "sain": "Sains (moy.)",
              "panne": "En panne (moy.)",
              "ratio": "Écart"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Écart"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "unit",
                "value": "suffix: ×"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
