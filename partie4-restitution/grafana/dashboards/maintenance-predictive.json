    {
      "id": 9,
      "type": "barchart",
      "title": "Attributs SMART critiques avant la panne (moyenne par jour restant)",
      "description": "Pour les disques tombés en panne : valeur moyenne de chaque attribut SMART N jours avant la panne (calcul RUL, SCRUM-40)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-maintenance"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-maintenance"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"smart_avant_panne\" and r._field != \"nb_obs\")\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"rul_jours\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({r with j: int(v: r.rul_jours)}))\n  |> sort(columns: [\"j\"], desc: true)\n  |> map(fn: (r) => ({r with rul_jours: \"J-\" + r.rul_jours}))\n  |> drop(fn: (column) => column == \"j\")"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "smart_5_raw": "5 · secteurs réalloués",
              "smart_187_raw": "187 · erreurs non corrigibles",
              "smart_197_raw": "197 · secteurs en attente",
              "smart_198_raw": "198 · secteurs non corrigibles"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
